generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  agent
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Channel {
  EMAIL
  CHAT
  WEB
  PHONE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum AuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}
