generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  agent
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Channel {
  EMAIL
  CHAT
  WEB
  PHONE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum AuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(agent)
  locale       String   @default("en")
  theme        String   @default("light")
  avatarColor  String   @default("#0ea5a4")
  createdAt    DateTime @default(now())

  assignedTickets Ticket[]  @relation("assignee")
  messages        Message[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([email])
}

model Ticket {
  id        String         @id @default(cuid())
  reference Int            @unique @default(autoincrement())
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  channel   Channel        @default(WEB)
  category  String         @default("General")
  sentiment Sentiment      @default(NEUTRAL)
  summary   String?        @db.Text
  aiTriaged Boolean        @default(false)
}
