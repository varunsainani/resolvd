generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  admin
  agent
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum Channel {
  EMAIL
  CHAT
  WEB
  PHONE
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum AuthorType {
  CUSTOMER
  AGENT
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(agent)
  locale       String   @default("en")
  theme        String   @default("light")
  avatarColor  String   @default("#0ea5a4")
  createdAt    DateTime @default(now())

  assignedTickets Ticket[]  @relation("assignee")
  messages        Message[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  createdAt DateTime @default(now())

  tickets Ticket[]

  @@index([email])
}

model Ticket {
  id        String         @id @default(cuid())
  reference Int            @unique @default(autoincrement())
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  channel   Channel        @default(WEB)
  category  String         @default("General")
  sentiment Sentiment      @default(NEUTRAL)
  summary   String?        @db.Text
  aiTriaged Boolean        @default(false)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?    @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  slaFirstDueAt   DateTime?
  slaResolveDueAt DateTime?

  messages Message[]
  tags     TicketTag[]

  @@index([status])
  @@index([priority])
  @@index([assigneeId])
  @@index([createdAt])
}

model Message {
  id           String     @id @default(cuid())
  ticketId     String
  ticket       Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorType   AuthorType
  authorUserId String?
  authorUser   User?      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  body         String     @db.Text
  isInternal   Boolean    @default(false)
  createdAt    DateTime   @default(now())

  @@index([ticketId])
}

model Tag {
  id      String      @id @default(cuid())
  name    String      @unique
  color   String      @default("#64748b")
  tickets TicketTag[]
}

model TicketTag {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tagId    String
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ticketId, tagId])
  @@index([tagId])
}

model CannedResponse {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  category  String   @default("General")
  createdAt DateTime @default(now())
}

model KbArticle {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  category  String   @default("General")
  keywords  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
